[Unit]
Description=Торг: запускать полный цикл раз в день

[Timer]
# Раз в сутки в 06:30 по времени сервера. Поменяй время при необходимости.
OnCalendar=*-*-* 06:30:00
# Если сервер спал/был выключен в момент запуска — догнать при следующем старте.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
