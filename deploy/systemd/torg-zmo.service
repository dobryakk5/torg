[Unit]
Description=Торг: ЗМО-цикл (сбор малых закупок + разбор + Telegram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
# config.py сам читает .env из WorkingDirectory. PATH нужен для curl-фолбэка ЕАТ
# и headless-браузера playwright (обновление анти-бот куков).
Environment=PATH=__PYTHON_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# flock -n: если прямо сейчас идёт дневной полный прогон (общий лок), этот 15-мин
# тик пропускается — не наслаиваемся на БД, следующий тик через 15 минут.
ExecStart=/usr/bin/flock -n /tmp/torg-pipeline.lock __PYTHON__ main.py --zmo
# Один прогон не должен висеть дольше, чем до следующего тика с запасом.
TimeoutStartSec=600
Nice=5

[Install]
WantedBy=multi-user.target
