[Unit]
Description=Торг: запускать ЗМО-цикл каждые 15 минут

[Timer]
# Первый прогон — через 3 мин после загрузки, далее каждые 15 мин от завершения
# предыдущего (OnUnitActiveSec считает от старта активации сервиса).
OnBootSec=3min
OnUnitActiveSec=15min
# Не копить пропущенные тики (напр. после сна/простоя) — запускаем один раз.
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
