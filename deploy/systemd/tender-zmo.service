[Unit]
Description=Тендерный монитор — ЗМО-цикл (сбор малых закупок + разбор + Telegram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
Environment=PATH=__PYTHON_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# flock -n -E 0: если лок занят (короткий дневной сбор) — тик пропускается
# ЧИСТО (exit 0, не «failure» в systemd), следующий через 15 минут. Обычно
# лок свободен: дневной сбор теперь короткий, тяжёлую обработку тянем мы сами.
# Основная нагрузка: этот цикл делает stage2+llm+отправку по ВСЕМ площадкам,
# по ближайшему дедлайну (ЗМО первыми) — поэтому таймаут щедрый.
ExecStart=/usr/bin/flock -n -E 0 /tmp/tender-pipeline.lock __PYTHON__ main.py --zmo
TimeoutStartSec=1800
Nice=5

[Install]
WantedBy=multi-user.target
