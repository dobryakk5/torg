[Unit]
Description=Тендерный монитор — ЗМО-цикл (сбор малых закупок + разбор + Telegram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__
Environment=PATH=__PYTHON_BIN_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# flock -n: если идёт дневной полный прогон (общий лок) — этот 15-мин тик
# пропускается, следующий через 15 минут. Так не наслаиваемся на БД.
ExecStart=/usr/bin/flock -n /tmp/tender-pipeline.lock __PYTHON__ main.py --zmo
TimeoutStartSec=600
Nice=5

[Install]
WantedBy=multi-user.target
